# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ciao?replicaSet=rs0

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-at-least-32-random-chars

# Server-side auth base URL — must match the public domain in production.
BETTER_AUTH_URL=https://your-domain.example.com

# IMPORTANT: NEXT_PUBLIC_APP_URL is baked into the client bundle at build time.
# Set this to the public-facing URL *before* running `next build`.
# If left unset the client falls back to window.location.origin (safe default).
NEXT_PUBLIC_APP_URL=https://your-domain.example.com

# ─── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set to "true" for port 465 (implicit TLS), "false" for STARTTLS (ports 587/25)
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com
