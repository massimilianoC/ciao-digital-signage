{
  "name": "ciao-digital-signage",
  "version": "0.2.1-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-start.mjs",
    "dev:clean": "node scripts/kill-port.mjs && node scripts/dev-start.mjs",
    "build": "next build",
    "build:deploy": "node scripts/prepare-deploy-build.mjs",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "npx tsx scripts/seed-admin.ts",
    "seed:users": "npx tsx scripts/seed-test-users.ts",
    "backfill:playlist-flags": "npx tsx scripts/backfill-playlist-playback-flags.ts",
    "db:reset": "npx tsx scripts/reset-test-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:line": "playwright test --reporter=line",
    "test:e2e:datasets": "playwright test --reporter=line e2e/webapps-datasets.spec.ts",
    "test:e2e:bindings-ui": "playwright test --reporter=line e2e/webapp-bindings-ui.spec.ts",
    "test:e2e:optional": "playwright test --reporter=line || node -e \"process.exit(0)\"",
    "test:e2e:auth": "playwright test --grep @auth --reporter=line",
    "test:e2e:public": "playwright test --grep-invert @auth --reporter=line",
    "test:e2e:bypass": "set E2E_BYPASS_AUTH=1&& playwright test e2e/smoke.spec.ts --reporter=line",
    "pipeline:refactor": "npm run typecheck",
    "pipeline:mvp": "npm run typecheck",
    "pipeline:legacy": "npm run typecheck",
    "pipeline:full": "npm run typecheck && npm run lint && npm run test:e2e:line",
    "pipeline:dataset-sandbox": "npm run typecheck && npm run test -- tests/services/webapp-host.service.test.ts && npm run test:e2e:datasets && npm run test:e2e:bindings-ui",
    "release:alpha": "npm version prerelease --preid=alpha",
    "release:beta": "npm version prerelease --preid=beta",
    "release:rc": "npm version prerelease --preid=rc",
    "release:stable": "npm version patch",
    "release:tag:preview": "node -e \"const v=require('./package.json').version; const d=new Date(); const yy=String(d.getFullYear()).slice(-2); const mm=String(d.getMonth()+1).padStart(2,'0'); console.log('v'+v+'+'+yy+'.'+mm);\"",
    "deploy:ssh:bootstrap": "bash ./.aws/bootstrap-lightsail.sh",
    "deploy:ssh": "bash ./.aws/deploy.sh",
    "deploy:ssh:install-hook": "bash ./.aws/install-post-commit-hook.sh",
    "deploy:native:ssh:bootstrap": "bash ./.aws/bootstrap-native.sh",
    "deploy:native:ssh": "bash ./.aws/deploy-native.sh",
    "deploy:native:ssh:install-hook": "bash ./.aws/install-post-commit-hook-native.sh",
    "deploy:native:step:check-ssh": "bash ./.aws/native-step-01-check-ssh.sh",
    "deploy:native:step:bootstrap": "bash ./.aws/native-step-02-bootstrap.sh",
    "deploy:native:step:local-build": "bash ./.aws/native-step-03-local-build.sh",
    "deploy:native:step:upload": "bash ./.aws/native-step-03-upload.sh",
    "deploy:native:step:build": "bash ./.aws/native-step-04-build.sh",
    "deploy:native:step:install-service": "bash ./.aws/native-step-05-install-service.sh",
    "deploy:native:step:install-apache": "bash ./.aws/native-step-06-install-apache-vhost.sh",
    "deploy:native:step:activate": "bash ./.aws/native-step-07-activate.sh",
    "deploy:native:step:status": "bash ./.aws/native-step-08-status.sh",
    "mvp:start": "node scripts/dev-start.mjs",
    "mvp:start:raw": "node server.js",
    "mvp:health": "node -e \"fetch(`http://localhost:${process.env.PORT || 3100}/api/health`).then(r=>r.text()).then(t=>{console.log(t); process.exit(0);}).catch(e=>{console.error(e); process.exit(1);})\"",
    "dev:services": "docker compose -f infra/docker/docker-compose.dev.yml up -d"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@rjsf/core": "^6.0.0-beta.22",
    "@rjsf/validator-ajv8": "^6.0.0-beta.22",
    "@xstate/react": "^6.1.0",
    "better-auth": "^1.4.19",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "jsoneditor": "^10.4.2",
    "lucide-react": "^0.575.0",
    "mongodb": "^7.1.0",
    "mongoose": "^9.2.3",
    "nanoid": "^5.1.6",
    "next": "16.1.6",
    "nodemailer": "^8.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.71.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "xstate": "^5.28.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
