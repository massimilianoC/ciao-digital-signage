# Ciao Digital Signage test credentials (copy values into your private .env.local if desired)
# NOTE: This file is example-only. Do not put real production credentials here.
# Recommended: copy these values into TEST-USERS.env.local for personal local seeds.
# By default the seed requires explicit passwords. Set the flag below to "true"
# only for disposable local setups where runtime-generated passwords are acceptable.
# SEED_ALLOW_PLACEHOLDER_PASSWORDS=false

# Super Admin
SUPER_ADMIN_EMAIL=super-admin@example.test
SUPER_ADMIN_PASSWORD=ChangeMe_SuperAdmin_2026!

# Organization Admin
ORG_ADMIN_EMAIL=org-admin@example.test
ORG_ADMIN_PASSWORD=ChangeMe_OrgAdmin_2026!

# Organization Member
ORG_MEMBER_EMAIL=org-member@example.test
ORG_MEMBER_PASSWORD=ChangeMe_OrgMember_2026!

# Optional seed params
APP_URL=http://localhost:3100
TEST_ORG_NAME=Demo Organization
TEST_ORG_SLUG=demo-organization
